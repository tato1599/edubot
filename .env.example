# Configuracion de ejemplo para el Agente Escolar
# Copiar a .env y modificar segun necesites

# App
APP_NAME="Agente Escolar Inteligente"
APP_VERSION=2.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Modelo LLM
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
DEVICE=auto
LOAD_IN_4BIT=true
LOAD_IN_8BIT=false
TEMPERATURE=0.2
MAX_NEW_TOKENS=350
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.15

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RETRIEVAL=5
RAG_DATA_DIR=backend/data
CHROMA_PERSIST_DIR=backend/chroma_db
CHROMA_COLLECTION_NAME=edubot_knowledge
CHROMA_BATCH_SIZE=100

# Performance
ENABLE_QUERY_CACHE=true
QUERY_CACHE_SIZE=1000
ENABLE_STREAMING=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
